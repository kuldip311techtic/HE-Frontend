# Relative /api path uses the Vite dev/preview proxy to avoid CORS during local development.
VITE_API_BASE_URL=/api

# Optional credentials for Luna live validation bootstrap (super admin only).
# Must match the backend SUPERADMIN_EMAIL / SUPERADMIN_PASSWORD.
# VITE_LUNA_VALIDATION_EMAIL=admin@example.com
# VITE_LUNA_VALIDATION_PASSWORD=ChangeMe1!
