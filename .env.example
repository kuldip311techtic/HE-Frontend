# Backend API root. Contract paths (e.g. /api/v1/super-admin/dashboard) are joined to this URL.
# Use http://localhost:3033 when paths include the /api prefix.
VITE_API_BASE_URL=http://localhost:3033

# Legacy alias — VITE_API_BASE_URL takes precedence when both are set.
NEXT_PUBLIC_API_URL=http://localhost:3033
