# Use `/api` in dev so Vite proxies to the backend; set absolute URL for production builds.
VITE_API_BASE_URL=/api
# Luna validation auto-login (OpenAPI LoginRequest example — super admin)
VITE_LUNA_VALIDATION_EMAIL=admin.hoopsengine@yopmail.com
VITE_LUNA_VALIDATION_PASSWORD=Admin@123
# Optional: skip login and inject a Bearer token directly
# VITE_LUNA_VALIDATION_ACCESS_TOKEN=
